{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nowable.local/schemas/nowable-publication-metadata.json",
  "title": "Nowable Publication Metadata",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "type",
    "id",
    "prospect_reference",
    "publication_metadata_path",
    "retrieval_policy",
    "landing_versions",
    "review"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "const": 1
    },
    "type": {
      "type": "string",
      "const": "nowable-publication-metadata"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "prospect_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rapigrowth_prospect_id",
        "company_name",
        "external_record_uri",
        "source"
      ],
      "properties": {
        "rapigrowth_prospect_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "company_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "external_record_uri": {
          "type": [
            "string",
            "null"
          ]
        },
        "source": {
          "type": "string",
          "enum": [
            "rapigrowth",
            "manual",
            "fixture",
            "other"
          ]
        }
      }
    },
    "publication_metadata_path": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_of_truth",
        "import_mode",
        "import_status",
        "owner",
        "reviewer",
        "source_uri",
        "external_writes_allowed",
        "notes"
      ],
      "properties": {
        "source_of_truth": {
          "type": "string",
          "enum": [
            "nowable",
            "manual_import",
            "fixture",
            "cloudflare_export",
            "other"
          ]
        },
        "import_mode": {
          "type": "string",
          "enum": [
            "manual",
            "automated",
            "fixture",
            "hybrid"
          ]
        },
        "import_status": {
          "type": "string",
          "enum": [
            "draft",
            "in_review",
            "approved",
            "blocked"
          ]
        },
        "owner": {
          "type": [
            "string",
            "null"
          ]
        },
        "reviewer": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_uri": {
          "type": [
            "string",
            "null"
          ]
        },
        "external_writes_allowed": {
          "type": "boolean",
          "const": false
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "retrieval_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "local_outputs_allowed",
        "evaluation_timestamp",
        "latest_rule",
        "approved_rule",
        "unknown_behavior",
        "notes"
      ],
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "latest",
            "approved",
            "latest_and_approved",
            "manual_selection"
          ]
        },
        "local_outputs_allowed": {
          "type": "boolean",
          "const": false
        },
        "evaluation_timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "latest_rule": {
          "type": "string",
          "minLength": 1
        },
        "approved_rule": {
          "type": "string",
          "minLength": 1
        },
        "unknown_behavior": {
          "type": "string",
          "minLength": 1
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "landing_versions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/landingVersion"
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "review_status",
        "confidence",
        "human_review_required",
        "notes"
      ],
      "properties": {
        "review_status": {
          "type": "string",
          "enum": [
            "draft",
            "in_review",
            "approved",
            "blocked"
          ]
        },
        "confidence": {
          "type": "string",
          "enum": [
            "high",
            "medium",
            "low"
          ]
        },
        "human_review_required": {
          "type": "boolean"
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  },
  "$defs": {
    "metadataSource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_uri",
        "source_of_truth",
        "import_mode"
      ],
      "properties": {
        "source_uri": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_of_truth": {
          "type": "string",
          "enum": [
            "nowable",
            "manual_import",
            "fixture",
            "cloudflare_export",
            "other"
          ]
        },
        "import_mode": {
          "type": "string",
          "enum": [
            "manual",
            "automated",
            "fixture",
            "hybrid"
          ]
        }
      }
    },
    "landingVersion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "prospect",
        "landing_identifier",
        "version",
        "version_sequence",
        "cloudflare_url",
        "deployment_timestamp",
        "ttl_expiry",
        "state",
        "approval_status",
        "metadata_source"
      ],
      "properties": {
        "prospect": {
          "type": [
            "string",
            "null"
          ]
        },
        "landing_identifier": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "version_sequence": {
          "type": "integer",
          "minimum": 1
        },
        "cloudflare_url": {
          "type": [
            "string",
            "null"
          ]
        },
        "deployment_timestamp": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "ttl_expiry": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "state": {
          "type": "string",
          "enum": [
            "draft",
            "published",
            "approved",
            "expired",
            "archived",
            "blocked"
          ]
        },
        "approval_status": {
          "type": "string",
          "enum": [
            "pending",
            "approved",
            "rejected",
            "not_required"
          ]
        },
        "metadata_source": {
          "$ref": "#/$defs/metadataSource"
        }
      }
    }
  }
}
