{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nowable.local/schemas/worker-handoff.json",
  "title": "Nowable Worker Handoff",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "type",
    "summary",
    "changed_files",
    "claims",
    "validation",
    "risks"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "const": 1
    },
    "type": {
      "type": "string",
      "const": "nowable-worker-handoff"
    },
    "summary": {
      "type": "string"
    },
    "changed_files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "reason"
        ],
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        }
      }
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "status",
          "evidence"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "pass",
              "fail",
              "blocked"
            ]
          },
          "evidence": {
            "type": "string"
          }
        }
      }
    },
    "validation": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "command",
          "result",
          "evidence"
        ],
        "additionalProperties": false,
        "properties": {
          "command": {
            "type": "string"
          },
          "result": {
            "type": "string",
            "enum": [
              "pass",
              "fail",
              "blocked"
            ]
          },
          "evidence": {
            "type": "string"
          }
        }
      }
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
