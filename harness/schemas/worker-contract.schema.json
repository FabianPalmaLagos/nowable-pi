{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nowable.local/schemas/worker-contract.json",
  "title": "Nowable Worker Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "type",
    "goal",
    "domain_lock",
    "claims",
    "validation_commands",
    "stop_rules"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "const": 1
    },
    "type": {
      "type": "string",
      "const": "nowable-worker-contract"
    },
    "goal": {
      "type": "string",
      "minLength": 1
    },
    "domain_lock": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "writable",
        "read_only",
        "forbidden"
      ],
      "properties": {
        "writable": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "read_only": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "forbidden": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "claim",
          "check",
          "evidence_expected"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "claim": {
            "type": "string",
            "minLength": 1
          },
          "check": {
            "type": "string",
            "minLength": 1
          },
          "evidence_expected": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "validation_commands": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "stop_rules": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
