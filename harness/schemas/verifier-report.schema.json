{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nowable.local/schemas/verifier-report.json",
  "title": "Nowable Verifier Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "type",
    "summary",
    "claims",
    "commands",
    "blockers"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "const": 1
    },
    "type": {
      "type": "string",
      "const": "nowable-verifier-report"
    },
    "summary": {
      "type": "string",
      "enum": [
        "pass",
        "fail",
        "partial",
        "blocked"
      ]
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "status",
          "evidence"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "pass",
              "fail",
              "unverifiable",
              "blocked"
            ]
          },
          "evidence": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          }
        }
      }
    },
    "commands": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "command",
          "exit",
          "evidence"
        ],
        "additionalProperties": false,
        "properties": {
          "command": {
            "type": "string"
          },
          "exit": {
            "type": "integer"
          },
          "evidence": {
            "type": "string"
          }
        }
      }
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
